rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for User creation
    function isValidNewUser(data) {
      return data.username is string && data.username.size() <= 100
          && data.totalPoints is number
          && (data.uid == request.auth.uid);
    }

    match /users/{userId} {
      // Allow any signed-in user to check if an inviter exists
      allow get: if isSignedIn();
      allow list: if isSignedIn(); // Allow leaderboard

      allow create: if isOwner(userId) && isValidNewUser(incoming()) && incoming().createdAt == request.time;
      
      allow update: if isSignedIn() && (
        // Action 1: Owner updates their profile (lastLogin, onboarding, wallet, tasks)
        (isOwner(userId) && incoming().lastLogin == request.time) ||
        
        // Action 2: Referral credit (another user increments points/count)
        (incoming().diff(existing()).affectedKeys().hasOnly(['referralCount', 'totalPoints']))
      );
      
      match /tasks/{taskId} {
        allow list, get: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(taskId);
      }
    }
  }
}
